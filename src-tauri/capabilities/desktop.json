{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "デスクトップ専用機能（トレイ・メニュー・ウィンドウ状態・単一インスタンス・自動更新）。platforms で macOS/Windows/Linux に限定する。",
  "platforms": ["macOS", "windows", "linux"],
  "windows": ["main"],
  "permissions": [
    "dialog:default",
    "fs:default",
    "fs:allow-read-text-file",
    "notification:default",
    "opener:default",
    "os:default",
    "window-state:default",
    "updater:default"
  ]
}
